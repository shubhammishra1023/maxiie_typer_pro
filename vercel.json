{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": ".",
  "bunVersion": "1.4.x",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|vendor/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
